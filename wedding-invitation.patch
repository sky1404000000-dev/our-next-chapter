diff --git a/src/components/Account.tsx b/src/components/Account.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..659ee76164325be853a605c344cef5ea31f42b3e
--- /dev/null
+++ b/src/components/Account.tsx
@@ -0,0 +1,53 @@
+'use client';
+
+import { useState } from 'react';
+import { weddingData, type AccountInfo } from '@/data/weddingData';
+
+function AccountRow({ info }: { info: AccountInfo }) {
+  const [copied, setCopied] = useState(false);
+
+  const copyAccount = async () => {
+    const text = `${info.bank} ${info.number} (${info.holder})`;
+    await navigator.clipboard.writeText(text);
+    setCopied(true);
+    setTimeout(() => setCopied(false), 1800);
+  };
+
+  return (
+    <div className="account-row">
+      <p>
+        <strong>은행명</strong>: {info.bank}
+      </p>
+      <p>
+        <strong>계좌번호</strong>: {info.number}
+      </p>
+      <p>
+        <strong>예금주</strong>: {info.holder}
+      </p>
+      <button type="button" className="action-btn small" onClick={copyAccount}>
+        {copied ? '복사 완료' : '복사하기'}
+      </button>
+    </div>
+  );
+}
+
+export default function Account() {
+  const { account } = weddingData;
+
+  return (
+    <section className="section" id="account">
+      <h2>{account.title}</h2>
+      <div className="card">
+        <p className="multiline muted">{account.message}</p>
+        <details className="accordion" open>
+          <summary>{account.groom.side}</summary>
+          <AccountRow info={account.groom} />
+        </details>
+        <details className="accordion">
+          <summary>{account.bride.side}</summary>
+          <AccountRow info={account.bride} />
+        </details>
+      </div>
+    </section>
+  );
+}
