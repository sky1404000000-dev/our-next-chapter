++  const copyAccount = async () => {
++    const text = `${info.bank} ${info.number} (${info.holder})`;
++    await navigator.clipboard.writeText(text);
++    setCopied(true);
++    setTimeout(() => setCopied(false), 1800);
++  };
++
++  return (
++    <div className="account-row">
++      <p>
++        <strong>은행명</strong>: {info.bank}
++      </p>
++      <p>
++        <strong>계좌번호</strong>: {info.number}
++      </p>
++      <p>
++        <strong>예금주</strong>: {info.holder}
++      </p>
++      <button type="button" className="action-btn small" onClick={copyAccount}>
