diff --git a/src/app/globals.css b/src/app/globals.css
new file mode 100644
index 0000000000000000000000000000000000000000..bcf13a116162c2b131223405b26943c44e147418
--- /dev/null
+++ b/src/app/globals.css
@@ -0,0 +1,237 @@
+:root {
+  --bg: #f2eee7;
+  --paper: #fffaf2;
+  --card: #fffdf8;
+  --text: #332d27;
+  --muted: #8a7e73;
+  --sage: #9caf88;
+  --blue: #9bb7c9;
+  --peach: #e8b79a;
+  --line: #e7ddd1;
+}
+
+* {
+  box-sizing: border-box;
+}
+
+html {
+  scroll-behavior: smooth;
+}
+
+body {
+  margin: 0;
+  background: var(--bg);
+  color: var(--text);
+  font-family: 'Pretendard', 'Noto Sans KR', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
+  line-height: 1.6;
+}
+
+h1,
+h2,
+h3,
+p {
+  margin: 0;
+}
+
+a {
+  color: inherit;
+  text-decoration: none;
+}
+
+.mobile-shell {
+  max-width: 430px;
+  min-height: 100vh;
+  margin: 0 auto;
+  padding: 24px 16px 40px;
+  background: var(--paper);
+  border-left: 1px solid var(--line);
+  border-right: 1px solid var(--line);
+}
+
+.section {
+  margin: 0 0 22px;
+  scroll-margin-top: 16px;
+}
+
+.card {
+  background: var(--card);
+  border: 1px solid var(--line);
+  border-radius: 18px;
+  padding: 16px;
+  box-shadow: 0 8px 20px rgba(75, 57, 45, 0.06);
+}
+
+.section h2 {
+  margin-bottom: 12px;
+  font-size: 1.2rem;
+}
+
+.hero-image-wrap {
+  border-radius: 20px;
+  overflow: hidden;
+}
+
+.hero-image {
+  width: 100%;
+  height: auto;
+  display: block;
+}
+
+.hero-content {
+  margin-top: 12px;
+  text-align: center;
+}
+
+.hero-kicker {
+  color: var(--muted);
+  font-size: 0.85rem;
+  letter-spacing: 0.06em;
+  margin-bottom: 6px;
+}
+
+.hero-content h1 {
+  font-size: 1.85rem;
+  margin-bottom: 8px;
+}
+
+.hero-meta {
+  font-size: 0.95rem;
+  color: var(--muted);
+}
+
+.multiline {
+  white-space: pre-line;
+}
+
+.lead {
+  margin-top: 10px;
+}
+
+.quick-menu-grid {
+  display: grid;
+  grid-template-columns: 1fr 1fr;
+  gap: 10px;
+}
+
+.quick-menu-btn {
+  min-height: 56px;
+  display: flex;
+  justify-content: center;
+  align-items: center;
+  font-weight: 600;
+  background: linear-gradient(180deg, #fffefb, #fff8ef);
+}
+
+.quick-menu-btn:nth-child(1) {
+  border-color: rgba(156, 175, 136, 0.4);
+}
+.quick-menu-btn:nth-child(2) {
+  border-color: rgba(155, 183, 201, 0.45);
+}
+.quick-menu-btn:nth-child(3) {
+  border-color: rgba(232, 183, 154, 0.5);
+}
+.quick-menu-btn:nth-child(4) {
+  border-color: rgba(156, 175, 136, 0.3);
+}
+
+.text-center {
+  text-align: center;
+}
+
+.story-grid,
+.gallery-grid,
+.guide-grid {
+  display: grid;
+  gap: 12px;
+}
+
+.story-date {
+  color: var(--muted);
+  font-size: 0.9rem;
+}
+
+.story-card h3,
+.guide-grid h3 {
+  margin: 4px 0 8px;
+}
+
+.polaroid {
+  padding: 10px;
+}
+
+.gallery-image,
+.map-image {
+  width: 100%;
+  height: auto;
+  border-radius: 12px;
+  display: block;
+}
+
+.polaroid figcaption {
+  margin-top: 8px;
+  color: var(--muted);
+  font-size: 0.92rem;
+  text-align: center;
+}
+
+.action-btn {
+  width: 100%;
+  margin-top: 12px;
+  min-height: 48px;
+  border-radius: 12px;
+  border: 1px solid var(--line);
+  background: #fff;
+  font-size: 0.95rem;
+  font-weight: 600;
+  color: var(--text);
+}
+
+.action-btn.small {
+  min-height: 44px;
+  margin-top: 0;
+}
+
+.button-grid {
+  margin: 14px 0;
+  display: grid;
+  grid-template-columns: 1fr 1fr;
+  gap: 8px;
+}
+
+.muted {
+  color: var(--muted);
+}
+
+.accordion {
+  margin-top: 10px;
+  border: 1px solid var(--line);
+  border-radius: 12px;
+  padding: 10px;
+  background: #fff;
+}
+
+.accordion summary {
+  cursor: pointer;
+  font-weight: 700;
+}
+
+.account-row {
+  margin-top: 10px;
+  display: grid;
+  gap: 4px;
+}
+
+.badge {
+  display: inline-block;
+  padding: 4px 10px;
+  border-radius: 999px;
+  background: rgba(155, 183, 201, 0.2);
+  color: #4d6372;
+  font-size: 0.78rem;
+  font-weight: 600;
+}
+
+.closing {
+  padding: 26px 18px;
+}
