index 0000000000000000000000000000000000000000..eaa6bac80f44a5d85b32ca4b1ac90d81e2eb18fd
--- /dev/null
+++ b/src/components/Gallery.tsx
@@ -0,0 +1,40 @@
+'use client';
+
+import { useMemo, useState } from 'react';
+import Image from 'next/image';
+import { weddingData } from '@/data/weddingData';
+
+export default function Gallery() {
+  const [expanded, setExpanded] = useState(false);
+  const { gallery } = weddingData;
+
+  const visibleItems = useMemo(() => {
+    if (expanded) return gallery.items;
+    return gallery.items.slice(0, gallery.initialCount);
+  }, [expanded, gallery.items, gallery.initialCount]);
+
+  return (
+    <section className="section" id="gallery">
+      <h2>{gallery.title}</h2>
+      <div className="gallery-grid">
+        {visibleItems.map((item) => (
+          <figure className="card polaroid" key={item.image}>
+            <Image
+              src={item.image}
+              alt={item.alt}
+              width={360}
+              height={260}
+              className="gallery-image"
+            />
+            <figcaption>{item.caption}</figcaption>
+          </figure>
+        ))}
+      </div>
+      {gallery.items.length > gallery.initialCount && (
+        <button type="button" className="action-btn" onClick={() => setExpanded((prev) => !prev)}>
+          {expanded ? '?묎린' : '?ъ쭊 ??蹂닿린'}
+        </button>
+      )}
+    </section>
+  );
+}
